  "scripts": {
    "start:backend": "cd casb && uvicorn backend.main:app --reload",
    "start:sfs": "cd secure-file-sharing && python app.py",

    "dev:frontend": "cd casb/frontend && npm run dev",
    "start:frontend": "cd casb/frontend && npm run build && npm run start",

    "dev": "concurrently \"npm run start:backend\" \"npm run dev:frontend\" \"npm run start:sfs\"",
    "start": "concurrently \"npm run start:backend\" \"npm run start:sfs\" \"npm run start:frontend\""


  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
